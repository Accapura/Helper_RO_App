<Window x:Class="HelperGos.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HelperGos"
        Title="Обновление" SizeToContent="Height" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False">

    <Window.Resources>
        <!-- Drives the rounded (pill-shaped) progress-bar fill below: turns a
             0-100 percentage into a proportional Grid star-width, so the fill
             column grows/shrinks purely via layout (no pixel-width math, no
             ActualWidth binding pitfalls). ConverterParameter="Inverse" gives
             the remaining (100 - value) share for the empty/track column. -->
        <local:PercentToStarWidthConverter x:Key="PercentToStarWidthConverter"/>
        <Style x:Key="UpdateDialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource UpdateDialogButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- Themed progress bar: fully rounded pill track and fill (matching
             every other rounded element in the app: buttons, cards, the
             badge on the "О проекте" tab), instead of the default WPF
             ProgressBar template's sharp rectangular corners. The fill's
             width comes from Grid star-columns driven by PercentToStarWidthConverter
             above, not a hand-rolled pixel Width, so it stays correctly
             proportional to Value/Maximum at any track width. -->
        <Style x:Key="UpdateDialogProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PercentToStarWidthConverter}}"/>
                                    <ColumnDefinition Width="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PercentToStarWidthConverter}, ConverterParameter=Inverse}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="{DynamicResource BackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource BorderColorBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="24" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontFamily="Georgia" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="4,18,4,0" LineHeight="20"/>

            <!-- Small version-comparison card: separates "current" and "new"
                 into their own labeled rows with the version numbers picked
                 out in bold accent, instead of burying them inside one long
                 wrapped sentence. -->
            <Border Grid.Row="2" x:Name="VersionCard"
                    Background="{DynamicResource BackgroundTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="4,14,4,0" Padding="16,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Текущая версия" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CurrentVersionText" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Доступна" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <!-- Two sub-rows: the hand-maintained "latest published"
                             version (AppData.LatestPublishedVersion) on top, the
                             remote build's actual last-modified date underneath;
                             see UpdateDialog.xaml.cs for why there are two values
                             here instead of one. -->
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="NewVersionText" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="NewVersionDateText" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Soft warning shown only when a genuinely new build was
                         detected (hash differs) but AppData.LatestPublishedVersion
                         still equals AppData.CurrentVersion: a reliable sign the
                         developer forgot to bump LatestPublishedVersion for this
                         build (see AppData.cs's pre-publish checklist). Purely
                         informational, doesn't block the update. -->
                    <TextBlock x:Name="VersionMismatchWarningText"
                               Visibility="Collapsed"
                               Text="⚠ Похоже, номер новой версии не был обновлён"
                               FontSize="10.5" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status/progress view: hidden while asking, shown while the
                 update actually downloads/installs, so the app never just
                 silently vanishes and reappears with no explanation. -->
            <StackPanel x:Name="StatusPanel" Grid.Row="3" Visibility="Collapsed" Margin="4,18,4,4">
                <TextBlock x:Name="StatusText" Text="Скачивание обновления..." FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource UpdateDialogProgressBar}"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="SecondaryButton" Content="Позже"
                        Style="{StaticResource UpdateDialogButton}" Click="SecondaryButton_Click"/>
                <Button x:Name="PrimaryButton" Content="Обновить"
                        Style="{StaticResource UpdateDialogPrimaryButton}" Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
